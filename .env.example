# Copy this file to .env.local and fill in the values.
# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay: Dashboard -> Account & Settings -> API Keys (use Test Mode keys first)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
# Dashboard -> Webhooks -> secret you choose when adding https://your-site/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Public URL of the site (used in emails and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
